{
    "AllowedHosts":  "localhost;127.0.0.1",
    "Logging":  {
                    "LogLevel":  {
                                     "Microsoft.AspNetCore":  "Warning",
                                     "Default":  "Information"
                                 }
                },
    "Cors":  {
                 "AllowedOrigins":  [
                                        "http://localhost:3001",
                                        "http://localhost:3002",
                                        "http://localhost:3003"
                                    ]
             },
    "ReverseProxy":  {
                         "Clusters":  {
                                          "staff":  {
                                                        "Destinations":  {
                                                                             "local":  {
                                                                                           "Address":  "http://localhost:5005/"
                                                                                       }
                                                                         }
                                                    },
                                          "reviews":  {
                                                          "Destinations":  {
                                                                               "local":  {
                                                                                             "Address":  "http://localhost:5007/"
                                                                                         }
                                                                           }
                                                      },
                                          "users":  {
                                                        "Destinations":  {
                                                                             "local":  {
                                                                                           "Address":  "http://localhost:5002/"
                                                                                       }
                                                                         }
                                                    },
                                          "catalog":  {
                                                          "Destinations":  {
                                                                               "local":  {
                                                                                             "Address":  "http://localhost:5003/"
                                                                                         }
                                                                           }
                                                      },
                                          "orders":  {
                                                         "Destinations":  {
                                                                              "local":  {
                                                                                            "Address":  "http://localhost:5004/"
                                                                                        }
                                                                          }
                                                     },
                                          "auth":  {
                                                       "Destinations":  {
                                                                            "local":  {
                                                                                          "Address":  "http://localhost:5001/"
                                                                                      }
                                                                        }
                                                   },
                                          "payments":  {
                                                           "Destinations":  {
                                                                                "local":  {
                                                                                              "Address":  "http://localhost:5006/"
                                                                                          }
                                                                            }
                                                       }
                                      },
                         "Routes":  {
                                        "staff":  {
                                                      "ClusterId":  "staff",
                                                      "Match":  {
                                                                    "Path":  "/api/staff/{**remainder}"
                                                                },
                                                      "Transforms":  [
                                                                         {
                                                                             "PathRemovePrefix":  "/api/staff"
                                                                         }
                                                                     ]
                                                  },
                                        "reviews":  {
                                                        "ClusterId":  "reviews",
                                                        "Match":  {
                                                                      "Path":  "/api/reviews/{**remainder}"
                                                                  },
                                                        "Transforms":  [
                                                                           {
                                                                               "PathRemovePrefix":  "/api/reviews"
                                                                           }
                                                                       ]
                                                    },
                                        "users":  {
                                                      "ClusterId":  "users",
                                                      "Match":  {
                                                                    "Path":  "/api/users/{**remainder}"
                                                                },
                                                      "Transforms":  [
                                                                         {
                                                                             "PathRemovePrefix":  "/api/users"
                                                                         }
                                                                     ]
                                                  },
                                        "catalog":  {
                                                        "ClusterId":  "catalog",
                                                        "Match":  {
                                                                      "Path":  "/api/catalog/{**remainder}"
                                                                  },
                                                        "Transforms":  [
                                                                           {
                                                                               "PathRemovePrefix":  "/api/catalog"
                                                                           }
                                                                       ]
                                                    },
                                        "orders":  {
                                                       "ClusterId":  "orders",
                                                       "Match":  {
                                                                     "Path":  "/api/orders/{**remainder}"
                                                                 },
                                                       "Transforms":  [
                                                                          {
                                                                              "PathRemovePrefix":  "/api/orders"
                                                                          }
                                                                      ]
                                                   },
                                        "auth":  {
                                                     "ClusterId":  "auth",
                                                     "Match":  {
                                                                   "Path":  "/api/auth/{**remainder}"
                                                               },
                                                     "Transforms":  [
                                                                        {
                                                                            "PathRemovePrefix":  "/api/auth"
                                                                        }
                                                                    ]
                                                 },
                                        "payments":  {
                                                         "ClusterId":  "payments",
                                                         "Match":  {
                                                                       "Path":  "/api/payments/{**remainder}"
                                                                   },
                                                         "Transforms":  [
                                                                            {
                                                                                "PathRemovePrefix":  "/api/payments"
                                                                            }
                                                                        ]
                                                     }
                                    }
                     }
}